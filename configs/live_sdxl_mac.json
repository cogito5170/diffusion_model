{
  "schema_version": "atelier.run_config.v1",
  "config_id": "config_live-sdxl-mac",
  "engine": {
    "engine_id": "diffusers-local",
    "model_id": "stabilityai/stable-diffusion-xl-base-1.0",
    "options": {
      "device": "auto",
      "dtype": "auto",
      "variant": "fp16",
      "allow_download": false,
      "isolate": true,
      "preferred_pixels": 802816
    }
  },
  "engine_params": {
    "num_inference_steps": 20,
    "guidance_scale": 6.0
  },
  "agent_backend": "claude_code",
  "batch_size": 4,
  "max_iterations": 2,
  "max_major_variables_per_iteration": 1,
  "weights": {
    "intent_alignment": 0.25,
    "material_plausibility": 0.2,
    "composition": 0.15,
    "visual_coherence": 0.15,
    "originality": 0.15,
    "technical_quality": 0.1
  },
  "selection": {
    "shortlist_size": 3,
    "mmr_lambda": 0.7,
    "near_duplicate_threshold": 0.08
  },
  "stopping": {
    "target_weighted_score": 4.2,
    "min_dimension_for_target": 3,
    "min_improvement": 0.1
  },
  "budget": {
    "max_total_images": 12,
    "max_generation_attempts": 16,
    "max_cost_usd": 0.0,
    "max_engine_seconds": 7200
  },
  "generation": {
    "timeout_s": 3600,
    "max_retries": 0,
    "retry_on_timeout": false,
    "base_seed": 20261010
  },
  "agents": {
    "max_rejections_per_step": 2
  },
  "qa": {
    "min_luma_std": 0.02,
    "max_clipped_fraction": 0.6,
    "min_sharpness": 1e-05
  },
  "require_human_approval": true
}
