{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atelier.invalid/schemas/material_spec.v1.json",
  "title": "Material Spec v1 (material-specialist output)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "material_spec_id", "draft_id", "produced_by", "materials", "lighting", "rationale", "plausibility_notes"],
  "properties": {
    "schema_version": {"const": "atelier.material_spec.v1"},
    "material_spec_id": {"$ref": "common.v1.json#/$defs/identifier"},
    "draft_id": {"$ref": "common.v1.json#/$defs/identifier"},
    "produced_by": {"$ref": "common.v1.json#/$defs/producer"},
    "materials": {"$ref": "art_direction.v1.json#/$defs/materials"},
    "lighting": {"$ref": "art_direction.v1.json#/$defs/lighting"},
    "rationale": {"$ref": "common.v1.json#/$defs/long_text"},
    "plausibility_notes": {"$ref": "common.v1.json#/$defs/short_text_list"}
  }
}
