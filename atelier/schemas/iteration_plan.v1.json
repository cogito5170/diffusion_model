{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atelier.invalid/schemas/iteration_plan.v1.json",
  "title": "Iteration Plan v1 (one bounded refinement experiment)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "plan_id", "iteration", "based_on_selection_id", "base_art_direction_id",
               "what_failed", "what_will_change", "what_remains_fixed", "why_it_should_help",
               "improvement_criterion", "keep_seeds"],
  "properties": {
    "schema_version": {"const": "atelier.iteration_plan.v1"},
    "plan_id": {"$ref": "common.v1.json#/$defs/identifier"},
    "iteration": {"type": "integer", "minimum": 1, "maximum": 5},
    "based_on_selection_id": {"$ref": "common.v1.json#/$defs/identifier"},
    "base_art_direction_id": {"$ref": "common.v1.json#/$defs/identifier"},
    "what_failed": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["dimension", "evidence"],
        "properties": {
          "dimension": {"$ref": "common.v1.json#/$defs/dimension"},
          "evidence": {"$ref": "common.v1.json#/$defs/long_text"}
        }
      }
    },
    "what_will_change": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "from", "to", "rationale"],
        "properties": {
          "path": {"type": "string", "pattern": "^(/[A-Za-z0-9_~-]+)+$", "description": "JSON Pointer into the art direction"},
          "from": {},
          "to": {},
          "rationale": {"$ref": "common.v1.json#/$defs/long_text"}
        }
      }
    },
    "what_remains_fixed": {"type": "array", "minItems": 1, "maxItems": 20, "items": {"$ref": "common.v1.json#/$defs/short_text"}},
    "why_it_should_help": {"$ref": "common.v1.json#/$defs/long_text"},
    "improvement_criterion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric", "aggregate", "comparator", "threshold"],
      "properties": {
        "metric": {"anyOf": [{"$ref": "common.v1.json#/$defs/dimension"}, {"const": "weighted_score"}]},
        "aggregate": {"enum": ["best", "mean"]},
        "comparator": {"enum": [">=", ">"]},
        "threshold": {"type": "number", "minimum": 1, "maximum": 5}
      }
    },
    "keep_seeds": {"type": "boolean"}
  }
}
